<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <solid android:color="#0B120E"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <gradient android:angle="90" android:startColor="#263D2F" android:centerColor="#1B2D22" android:endColor="#17251C"/>
            <stroke android:width="1dp" android:color="#557FB392"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:height="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp"/>
            <solid android:color="#2E4938"/>
        </shape>
    </item>
</layer-list>